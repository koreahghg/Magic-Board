# Neon PostgreSQL 연결 문자열
# Neon 콘솔(https://console.neon.tech)에서 프로젝트 생성 후 Connection String 복사
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-xxxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Cron 요청 인증 시크릿 (랜덤 문자열로 설정)
CRON_SECRET="your-cron-secret"

# 초기 설정 후 실행 순서:
# 1. npx prisma generate       — Prisma Client 생성
# 2. npx prisma migrate dev --name init  — 첫 마이그레이션 실행
